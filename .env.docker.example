# Copy to `.env` in this same directory (~/marketing-agent) before running
# `docker compose up -d --build`. docker-compose.yml loads this via env_file
# for the backend service. Do not commit the filled-in .env.

APP_PORT=8082
APP_ENV=production

# Container service names from docker-compose.yml — leave as-is.
MONGO_URI=mongodb://mongo:27017/autonomous-marketing-agent
REDIS_URL=redis://redis:6379

# Auth — single-operator login (POST /api/v1/auth/login). Required — the
# app throws at boot if AUTH_JWT_SECRET is unset. Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# AI providers
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_AI_API_KEY=
IMAGE_PROVIDER=nano_banana
FAL_API_KEY=
HEYGEN_API_KEY=
CARTESIA_API_KEY=
CARTESIA_HINDI_VOICE_ID=

# YouTube Data API — required for YouTube scout
YOUTUBE_API_KEY=

# Apify
APIFY_API_KEY=

# Slack / ops alerting
SLACK_WEBHOOK_91ASTROLOGY=
OPS_ALERT_WEBHOOK=
