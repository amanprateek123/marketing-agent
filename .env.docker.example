# Copy to `.env` in this same directory (~/marketing-agent) before running
# `docker compose up -d --build`. docker-compose.yml loads this via env_file
# for the backend service. Do not commit the filled-in .env.

APP_PORT=8082
APP_ENV=production

# Container service names from docker-compose.yml — leave as-is.
MONGO_URI=mongodb://mongo:27017/autonomous-marketing-agent
REDIS_URL=redis://redis:6379

# Auth — single-operator login (POST /api/v1/auth/login). Required — the
# app throws at boot if AUTH_JWT_SECRET is unset. Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# AI providers
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_AI_API_KEY=
IMAGE_PROVIDER=nano_banana
FAL_API_KEY=
HEYGEN_API_KEY=
CARTESIA_API_KEY=
CARTESIA_HINDI_VOICE_ID=

# YouTube Data API — required for YouTube scout
YOUTUBE_API_KEY=

# Apify
APIFY_API_KEY=

# Notifications are Brain alerts shown in the dashboard (no Slack webhooks).

# --- Performance Marketeer (src/performance-marketeer) ---
# OpenPanel ClickHouse, read-only user (insights_reader)
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
OPENPANEL_PROJECT_ID=91astro-website
# 91astro production Mongo, read through Metabase's API (key in a group limited to 91astrology-prod)
METABASE_URL=
METABASE_API_KEY=
METABASE_DATABASE_ID=2
PM_TENANT_ID=91astrology
# Crons + sync API stay off until this is true
PM_SYNC_ENABLED=false
# AI campaign analysis queue (dashboard-triggered, no cron). Worker runs in this process only when true.
PM_AGENT_WORKER=false
# Campaign runs in parallel: queue worker default 1; CLI `all` default 3
PM_AGENT_CONCURRENCY=
# Daily LLM spend cap per run date in USD (default 100); queued runs wait once reached
PM_AGENT_MAX_USD_PER_DAY=
# Performance Marketeer — Meta (System User token, ads_read only)
META_ACCESS_TOKEN=
# Competitor ads (useproxy.dev MCP); AUTHORIZATION is the full header value incl. "Bearer"
PROXY_MCP_URL=
PROXY_MCP_AUTHORIZATION=
PM_PROXY_DAILY_CREDITS=
# AI analyst working folders — must be writable by the container user and on a volume
PM_AGENT_DIR=
PM_AGENT_CACHE_DIR=
# Optional local headless Chrome for landing-page screenshots (text only without it)
PM_CHROME_PATH=
# Claude login for the Agent SDK on servers (one of these)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
