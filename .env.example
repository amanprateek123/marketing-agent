# App
APP_PORT=3000
APP_ENV=development

# Auth — single-operator login (POST /api/v1/auth/login). Every API route
# requires the resulting JWT unless explicitly @Public(). Generate
# AUTH_JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_JWT_SECRET=
# Token lifetime in seconds. Default 604800 = 7 days.
AUTH_TOKEN_TTL_SECONDS=604800

# MongoDB
MONGO_URI=mongodb://localhost:27017/autonomous-marketing-agent

# Redis
REDIS_URL=redis://localhost:6379


# Meta Ads
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# YouTube Data API — required for YouTube scout
YOUTUBE_API_KEY=

# Image/Video Generation
IDEOGRAM_API_KEY=
FAL_API_KEY=
KLING_API_KEY=

# ── External creative pipeline (Custom brief on the /creatives page) ──
# The pipeline runs on its own box and owns authoring + image generation.
# This backend only proxies to it (src/pipeline-bridge) and receives finished
# creatives through the ordinary POST /creative/:tenantId/packages/upload-bulk.
# Unset PIPELINE_API_URL = the Custom-brief path returns 503; nothing else is
# affected. The token is held server-side and never reaches the browser.
PIPELINE_API_URL=
PIPELINE_API_TOKEN=
PIPELINE_API_TIMEOUT_MS=30000
